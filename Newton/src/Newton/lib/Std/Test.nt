; Filename: Test.nt
; Description: Test module for Newton's standard library.
; Date: April 13th, 2026

using Std::Terminal

fun TestCase: @args test_name, actual, expected
	; Error Handling
	if (typeof $test_name) != "string":
		return ["error", "In function Test.TestCase ; Expected type string for argument #1; got " << (typeof $test_name)]
	end

	if $actual == $expected:
		IO.Std_Println Terminal.Success $test_name << " [PASS]"
		return ["ok", 1]
	else:
		IO.Std_Println Terminal.Error $test_name << " [FAIL]"
		IO.Std_Println "; Expected: " << (string $expected)
		IO.Std_Println "; Actual:   " << (string $actual)
		return ["ok", 0]
		; die "Failed Unit Test <" << $test_name << ">", 1
	end
end
