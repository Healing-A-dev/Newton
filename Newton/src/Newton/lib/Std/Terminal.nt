; Filename: Terminal.nt
; Description: Terminal module for the newton standard library
; Date: April 30th, 2026 *


; --- Base ---
set RESET*: "\x1b[0m"
set BOLD*:  "\x1b[1m"

; --- Foreground ---
set BLACK*:   "\x1b[30m"
set RED*:     "\x1b[31m"
set GREEN*:   "\x1b[32m"
set YELLOW*:  "\x1b[33m"
set BLUE*:    "\x1b[34m"
set MAGENTA*: "\x1b[35m"
set CYAN*:    "\x1b[36m"
set WHITE*:   "\x1b[37m"

; --- Background ---
set BG_RED*:    "\x1b[41m"
set BG_GREEN*:  "\x1b[42m"
set BG_YELLOW*: "\x1b[43m"
set BG_BLUE*:   "\x1b[44m"

; --- Helper Functions ---

fun Text:
    @args color_code, text
    set res: $color_code << $text << $Terminal.RESET
    return ["ok", $res]
end

fun Error:
    @args msg
    set res: $Terminal.RED << "[ERROR] " << $Terminal.RESET << $msg
    return ["ok", $res]
end

fun Success:
    @args msg
    set res: $Terminal.GREEN << "[SUCCESS] " << $Terminal.RESET << $msg
    return ["ok", $res]
end

fun Warning:
    @args msg
    set res: $Terminal.YELLOW << "[WARNING] " << $Terminal.RESET << $msg
    return ["ok", $res]
end

fun Debug:
	@args msg
	set res: $Terminal.CYAN << "[DEBUG] " << $Terminal.RESET << $msg
	return ["ok", $res]
end
