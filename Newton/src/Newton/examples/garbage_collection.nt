fun Main:
    set i: 0
    println "Starting Memory Stress Test..."

    while $i < 500000:
        | Concatenate two strings. This forces 'malloc' to run.
        set temp: "Stress Test Allocation " << " - Placeholder"
        i: $i + 1
    end

    println "Success! 500,000 allocations handled without crashing."
end
