| Simple Iota function
set __IOTA__*: -1
fun iota:
	enum.__IOTA__: $enum.__IOTA__ + 1
	return [@ok, $enum.__IOTA__]
end

fun zero:
  enum.__IOTA__: 0
  return [@ok, 1]
end

