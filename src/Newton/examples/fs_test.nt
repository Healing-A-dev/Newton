; Native read_file test
fun main:
    @println "Testing File System..."

    set content: read_file "index.html"
    @println "Read " << string (sizeof $content) << " bytes."
    @println "Content Preview:  " <<  $content

    set missing: read_file "does_not_exist.txt"
    @println "Missing file length: " << string (sizeof $missing)
    @println "Test Complete."
end
