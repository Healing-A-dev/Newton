using std::web
using std::process
using std::terminal

set db*: ()

fun handle_request:
    @args client

    set req: web.recieve $client, 4096

    if (sizeof $req) == 0:
        web.close $client
        return
    end

    set method: ""
    set path: ""
    set i: 0
    set req_sizeof: sizeof $req
    set state: 0

    while $i < $req_sizeof:
        set c: string.sub $req, $i, 1
        if $state == 0:
            if $c == " ": state: 1 else: method: $method << $c end
        elseif $state == 1:
            if $c == " ": state: 2 break else: path: $path << $c end
        end
        i: $i + 1
    end

    ; Strip leading slash
    if (sizeof $path) > 1:
        if (string.sub $path, 0, 1) == "/":
            path: string.sub $path, 1, ((sizeof $path) - 1)
        end
    end

    @println terminal.text $terminal.YELLOW, "[" << $method << "] /" << $path

    set parts: []
    set current: ""
    set p_sizeof: sizeof $path
    set j: 0

    while $j < $p_sizeof:
        set c: string.sub $path, $j, 1
        if $c == "/":
            ;set_index $parts, (sizeof $parts), $current
            parts{(sizeof $parts)}: $current
            current: ""
        else:
            current: $current << $c
        end
        j: $j + 1
    end
    if (sizeof $current) > 0:
        ;set_index $parts, (sizeof $parts), $current
        parts{(sizeof $parts)}: $current
    end

    set action: ""
    if (sizeof $parts) > 0: action: $parts{0} end

    set response_body: ""
    set status: "200 OK"

    if $action == "set":
        if (sizeof $parts) >= 3:
            set key: $parts{1}
            set val: $parts{2}

            ; set_index $db, $key, $val
            db{$key}: $val
            response_body: "{ 'status': 'success', 'key': '" << $key << "', 'value': '" << (string $val) << "' }"
        else:
            status: "400 Bad Request"
            response_body: "{ 'error': 'Usage: /set/key/value' }"
        end

    elseif $action == "get":
        if (sizeof $parts) >= 2:
            set key: $parts{1}
            set val: $db{$key}

            if (typeof $val) == "int":
                status: "404 Not Found"
                response_body: "{ 'error': 'Key not found' }"
            else:
                response_body: "{ 'key': '" << $key << "', 'value': '" << (string $val) << "' }"
            end
        else:
            status: "400 Bad Request"
            response_body: "{ 'error': 'Usage: /get/key' }"
        end

    elseif $action == "dump":
        response_body: "{ 'keys_count': " << (string (sizeof $db)) << " }"

    else:
        status: "404 Not Found"
        response_body: "{ 'error': 'Unknown command. Try /set/key/value or /get/key' }"
    end

    set header: "HTTP/1.1 " << $status << "\r\n"
    header: $header << "Server: NewtonKV/1.0\r\n"
    header: $header << "Content-Type: application/json\r\n"
    header: $header << "Content-sizeofgth: " << (sizeof $response_body) << "\r\n"
    header: $header << "Connection: close\r\n\r\n"

    web.send $client, $header << $response_body

    if $status == "200 OK":
        @println terminal.success "  -> " << $status
    else:
        @println terminal.error "  -> " << $status
    end

    process.sleep 1
    web.close $client
end

fun main:
    set port: 8081
    @println terminal.text $terminal.CYAN, "--- NEWTON KV SERVER v1.0 ---"
    @println terminal.text $terminal.BLUE, "[*] Running synchronously on http://localhost:" << (string $port)

    set server: web.new
    web.bind $server, $port
    web.listen $server

    while 1 == 1:
        set client: web.accept $server
        handle_request $client
    end
end
