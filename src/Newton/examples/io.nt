fun Main:
    println "--- File I/O with Constants ---"

    println "Opening for Write..."
    set fd: (fopen "test.txt", $fmWrite)

    File.Write $fd, "This was written using global constants!"
    File.Close $fd

    | 2. Read using the exported constant
    | $File.fmRead resolves to 0 (O_RDONLY)
    println "Opening for Read..."
    set fd2: (fopen "test.txt", $fmRead)

    set content: (File.Read $fd2, 100)
    println "Content: " << $content

    File.Close $fd2
end
