fun add: @args a, b
    return $a + $b
end

fun apply: @args val1, val2, func
    @println "Called function dynamically."
    return call $func ($val1, $val2)
end

fun main:
    ; Store function in variable
    set my_op: $add

    ; Pass it to another function
    set result: (apply 10, 20, $my_op)

	; Display the result
    @println "Result: {}", $result
end
