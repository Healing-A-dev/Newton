fun main:
    set filename: $argv{1}

    if $filename == 0:
        @println "Error: Please provide a filename."
        @println "Usage: ./my_cat [filename]"
        return
    end

    @println "Reading file: " << $filename

    set fd: fopen $filename, "r"
    set content: fgets $fd, 1024

    @println "--- Content ---"
    @print $content
    @println "\n---------------"
    fclose $fd
end
