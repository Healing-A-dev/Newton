fun main:
    @println "--- Newton Filesystem Manager ---"

    ; 1. Create a Directory
    @println "[*] Creating directory 'newton_data'..."
    set status: newDirectory "newton_data"

    if $status < 0:
        @println "[-] Failed to create directory. It might already exist."
    else:
        @println "[+] Directory created successfully!"
    end

    ; 2. Write a file inside the new directory
    @println "[*] Creating file 'newton_data/test.txt'..."
    set fd: fopen "newton_data/test.txt", $fmWrite
    fwrite $fd, "Hello from the new directory!\n"
    fclose $fd

    ; 3. Check if the file exists
    set does_exist: fileExists "newton_data/test.txt"
    if $does_exist == 1:
        @println "[+] Verified: The file exists on the hard drive!"
    else:
        @println "[-] Error: The file is missing!"
    end

    ; 4. Cleanup (Ask user first)
    set ans: @readln "Do you want to delete the file we just created? (y/n): "
    if $ans == "y":
        set del_status: deleteFile "newton_data/test.txt"
        if $del_status == 0:
            @println "[+] File deleted permanently!"
        else:
            @println "[-] Failed to delete file."
        end
    else:
        @println "[*] File kept safely on disk."
    end
end
