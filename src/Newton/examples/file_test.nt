using std::File
using std::IO

fn main:
    IO.println "--- Newton Filesystem Manager ---"
    
    ; 1. Create a Directory
    IO.println "[*] Creating directory 'newton_data'..."
    set status: File.mkdir "newton_data"
    
    if $status < 0:
        IO.println "[-] Failed to create directory. It might already exist."
    else:
        IO.println "[+] Directory created successfully!"
    end
    
    ; 2. Write a file inside the new directory
    IO.println "[*] Creating file 'newton_data/test.txt'..."
    set fd: File.open "newton_data/test.txt", $File.fmWrite
    File.write $fd, "Hello from the new directory!\n"
    File.close $fd
    
    ; 3. Check if the file exists
    set does_exist: File.exists "newton_data/test.txt"
    if $does_exist == 1:
        IO.println "[+] Verified: The file exists on the hard drive!"
    else:
        IO.println "[-] Error: The file is missing!"
    end
    
    ; 4. Cleanup (Ask user first)
    set ans: IO.prompt "Do you want to delete the file we just created? (y/n): "
    if $ans == "y":
        set del_status: File.delete "newton_data/test.txt"
        if $del_status == 0:
            IO.println "[+] File deleted permanently!"
        else:
            IO.println "[-] Failed to delete file."
        end
    else:
        IO.println "[*] File kept safely on disk."
    end
end
