using std::web
using std::json
using std::terminal
using std::process


fun handleRequest: @args client
	set req: web.recieve $client, 4096

	; Empty Request
	if (sizeof $req) == 0:
		web.close $client
		return ["ok", 0]
	end
	@println $req

	process.sleep 1
	web.close $client
end

fun main:
	set PORT: 8081
	set SERVER: web.new
	web.bind $SERVER, $PORT
	web.listen $SERVER
	@println "Listening on port: " << $PORT

	while 1:
		set CLIENT: web.accept $SERVER
		handleRequest $CLIENT
	end
end
