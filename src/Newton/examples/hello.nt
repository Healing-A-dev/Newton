using Std::Web
using Std::Json
using Std::Terminal
using Std::Process


fun handleRequest: @args client
	set req: Web.Recieve $client, 4096

	| Empty Request
	if (sizeof $req) == 0: 
		Web.Close $client
		return ["ok", 0]
	end

	println $req

	
	Process.Sleep 1
	Web.Close $client
end

fun Main:
	set PORT: 8081
	set SERVER: Web.New
	Web.Bind $SERVER, $PORT
	Web.Listen $SERVER

	| println "Listening on port: " << $PORT

	while 1:
		set CLIENT: Web.Accept $SERVER
		handleRequest $CLIENT
	end
end
