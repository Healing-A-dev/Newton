fun main:
    set i: 0
    @println "Starting Memory Stress Test..."
    while $i < 5000:
        set s_val: string $i
        set temp: "Allocation " << $s_val
        if $i == 1000:
            @println $temp end
        if $i == 2000:
            @println $temp end
        if $i == 3000:
            @println $temp end
        if $i == 4000:
            @println $temp end
        i: $i + 1
    end
    @println "Success!"
end
