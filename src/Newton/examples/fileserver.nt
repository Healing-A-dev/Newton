using std::web
using std::process
using std::terminal

; --- Helper: Create default index.html if missing ---
fun ensure_index_html:
    set fd: fopen "index.html", 0
    if $fd > 0:
        fclose $fd
        return
    end

    @println terminal.warning "[*] 'index.html' not found. Creating default file..."

    set fd_write: fopen "index.html", "w"
    set html: "<html><head><title>Newton Server</title></head>"
    html: $html << "<body style='font-family: sans-serif; text-align: center; padding: 50px;'>"
    html: $html << "<h1 style='color: #2ecc71;'>It Works!</h1>"
    html: $html << "<p>Your Newton Static Server is running.</p>"
    html: $html << "<hr><i>Powered by Newton Lang</i></body></html>"

    fwrite $fd_write, $html
    fclose $fd_write
    @println terminal.success "[+] Default 'index.html' created."
end

fun handle_request:
    @args client

    set req: web.recieve $client, 4096
    if (sizeof $req) == 0:
        web.close $client
        process.exit 0
    end

    set method: ""
    set path: ""
    set i: 0
    set req_len: sizeof $req
    set state: 0 ; 0=Method, 1=Path, 2=Done

    while $i < $req_len:
        set c: string.sub $req, $i, 1

        if $state == 0:
            if $c == " ":
                state: 1
            else:
                method: $method << $c
            end
        elseif $state == 1:
            if $c == " ":
                state: 2
                break
            else:
                path: $path << $c
            end
        end

        i: $i + 1
    end

    if $path == "/":
        path: "index.html"
    else:
        ; Remove leading slash: "/file" -> "file"
        if (sizeof $path) > 1:
            path: string.sub $path, 1, ((sizeof $path) - 1)
        end
    end

    @println terminal.text $terminal.YELLOW, "[" << $method << "] " << $path

    set safe: 1
    if (sizeof $method) == 0: safe: 0 end
    if (sizeof $path) >= 2:
        if (string.sub $path, 0, 2) == "..": safe: 0 end
    end

    if $safe == 1:
    	@println terminal.debug "File Path: " << $path
        set content: readfile $path

        @println terminal.debug "File length: " << string (sizeof $content)
        @println terminal.debug "File contents: " << $content

        if (sizeof $content) > 0:
            set header: "HTTP/1.1 200 OK\r\n"
            header: $header << "Content-Type: text/html\r\n"
            header: $header << "Connection: close\r\n\r\n"

            web.send $client, $header << $content
            @println terminal.success "  -> 200 OK"
        else:
            set body: "<h1>404 Not Found</h1>"
            set header: "HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n"
            web.send $client, $header << $body
            @println terminal.error "  -> 404 Not Found"
        end
    else:
        set body: "<h1>400 Bad Request</h1>"
        set header: "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n"
        web.send $client, $header << $body
        @println terminal.error "  -> 400 Bad Request"
    end

    process.sleep 1
    web.close $client
    process.exit 0
end

fun main:
    set port: 8080
   	@println terminal.text $terminal.CYAN, "--- NEWTON STATIC SERVER v1.3 ---"

    ; Ensure we have a file to serve!
    ensure_index_html

    @println terminal.text $terminal.BLUE, "[*] Serving files on http://localhost:" << (string $port)

    set server: web.new
    web.bind $server, $port
    web.listen $server

    while 1 == 1:
        set client: web.accept $server
        set pid: process.fork 0
        if $pid == 0:
            handle_request $client
        else:
            web.close $client
        end
    end
end
