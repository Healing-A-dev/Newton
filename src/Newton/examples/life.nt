using std::process
using std::math
using std::terminal

; --- Helper to get cell state safely (handles boundaries) ---
fun get_cell:
    @args grid, x, y, w, h
    if $x < 0: return 0 end
    if $x >= $w: return 0 end
    if $y < 0: return 0 end
    if $y >= $h: return 0 end

    set idx: ($y * $w) + $x
    return $grid{$idx}
end

; --- Helper to count alive neighbors ---
fun count_neighbors:
    @args grid, x, y, w, h
    set count: 0
    count: $count + (get_cell $grid, ($x - 1), ($y - 1), $w, $h)
    count: $count + (get_cell $grid, $x, ($y - 1), $w, $h)
    count: $count + (get_cell $grid, ($x + 1), ($y - 1), $w, $h)
    count: $count + (get_cell $grid, ($x - 1), $y, $w, $h)
    count: $count + (get_cell $grid, ($x + 1), $y, $w, $h)
    count: $count + (get_cell $grid, ($x - 1), ($y + 1), $w, $h)
    count: $count + (get_cell $grid, $x, ($y + 1), $w, $h)
    count: $count + (get_cell $grid, ($x + 1), ($y + 1), $w, $h)
    return $count
end

fun main:
    set w: 15
    set h: 15
    set size: $w * $h

    ; Initialize the grid with random noise
    set grid: []
    set i: 0
    while $i < $size:
        ; 25% chance for a cell to start alive
        set r: math.random 4
        if $r == 0:
            set_index $grid, $i, 1
        else:
            set_index $grid, $i, 0
        end
        i: $i + 1
    end

    ; Main Game Loop
    while 1 == 1:
        @print "\x1b[2J\x1b[H"
        @println terminal.text $terminal.CYAN, "--- Newton's Game of Life ---"

        ; Draw the current generation
        set y: 0
        while $y < $h:
            set row_str: ""
            set x: 0
            while $x < $w:
                set idx: ($y * $w) + $x
                set cell: $grid{$idx}

                if $cell == 1:
                    row_str: $row_str << "[]"  ; Alive Cell
                else:
                    row_str: $row_str << ".."  ; Dead Cell
                end

                x: $x + 1
            end
            if $y == 0:
                @println terminal.text $terminal.GREEN, $row_str
            else:
                @println $row_str
            end
            y: $y + 1
        end

        ; Next Generation
        set next_grid: []

        set i2: 0
        while $i2 < $size:
            set_index $next_grid, $i2, 0
            i2: $i2 + 1
        end

        ; Conway's Rules
        set cy: 0
        while $cy < $h:
            set cx: 0
            while $cx < $w:
                set c_idx: ($cy * $w) + $cx
                set state: $grid{$c_idx}
                set neighbors: count_neighbors $grid, $cx, $cy, $w, $h

                if $state == 1:
                    if $neighbors == 2: set_index $next_grid, $c_idx, 1 end
                    if $neighbors == 3: set_index $next_grid, $c_idx, 1 end
                else:
                    if $neighbors == 3: set_index $next_grid, $c_idx, 1 end
                end
                cx: $cx + 1
            end
            cy: $cy + 1
        end

        ; Swap the arrays and wait before drawing the next frame
        grid: $next_grid
        process.sleep 1
    end
end
