using std::web
using std::process
using std::terminal
using std::json

set db*: ()
set db_keys*: []

; --- PERSISTENCE ---
fun save_db:
    set content: ""
    set i: 0
    while $i < (sizeof $db_keys):
        set k: $db_keys{$i}
        set v: $db{$k}
        content: $content << $k << "=" << $v << "\n"
        i: $i + 1
    end

    set fd: fopen "db.txt", "w"
    if $fd > 0:
        fwrite $fd, $content
        fclose $fd
    end
end

fun load_db:
    set fd: fopen "db.txt", "r"
    if $fd < 0:
        @println terminal.warning "[*] No existing database found. Starting fresh."
        return
    end
    fclose $fd

    set content: readfile "db.txt"
    if (sizeof $content) == 0:
        return
    end

    set i: 0
    set c_len: sizeof $content
    set curr_key: ""
    set curr_val: ""
    set parsing_key: 1

    while $i < $c_len:
        set c: string.sub $content, $i, 1
        if $c == "\n":
            if (sizeof $curr_key) > 0:
                db{$curr_key}: $curr_val
                db_keys{(sizeof $db_keys)}: $curr_key
            end
            curr_key: ""
            curr_val: ""
            parsing_key: 1
        else:
            if $c == "=":
                if $parsing_key == 1:
                    parsing_key: 0
                else:
                    curr_val: $curr_val << $c
                end
            else:
                if $parsing_key == 1:
                    curr_key: $curr_key << $c
                else:
                    curr_val: $curr_val << $c
                end
            end
        end
        i: $i + 1
    end
    @println terminal.success "[+] Database loaded! Keys restored: " << (sizeof $db_keys)
end

; --- TEMPLATE GENERATOR ---
fun ensure_template_html:
    set fd: fopen "index.html", "r"
    if $fd > 0:
        fclose $fd
        return
    end

    @println terminal.warning "[*] Generating default 'index.html' template..."
    set fd_write: fopen "index.html", "w"

    set html: "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Newton Dashboard</title>"
    html: $html << "<style>body{font-family:sans-serif; margin:40px; background:#1e1e1e; color: white;} "
    html: $html << "table{width: 100%; border-collapse: collapse; margin-top: 20px; background: #2d2d2d;} "
    html: $html << "th, td{padding: 12px; border: 1px solid #444; text-align: left;} "
    html: $html << "th{background-color: #2ecc71; color: #111; font-weight: bold;} "
    html: $html << ".btn-del{background: #ff4757; color: white; padding: 5px 10px; text-decoration: none; border-radius: 4px; font-size: 14px;}</style></head><body>"
    html: $html << "<h1>🗄️ Newton DB Dashboard</h1>"
    html: $html << "<table><tr><th>Key</th><th>Value</th><th style='width: 80px;'>Action</th></tr>"
    html: $html << "{{table_rows}}"
    html: $html << "</table></body></html>"

    fwrite $fd_write, $html
    fclose $fd_write
end

; --- HTTP ROUTER ---
fun handle_request:
    @args client

    set req: web.recieve $client, 4096
    if (sizeof $req) == 0:
        web.close $client
        return
    end

    set method: ""
    set path: ""
    set i: 0
    set req_len: sizeof $req
    set state: 0

    while $i < $req_len:
        set c: string.sub $req, $i, 1
        if $state == 0:
            if $c == " ":
                state: 1
            else:
                method: $method << $c
            end
        elseif $state == 1:
            if $c == " ":
                state: 2
                break
            else:
                path: $path << $c
            end
        end
        i: $i + 1
    end

    if (sizeof $path) > 1:
        if (string.sub $path, 0, 1) == "/":
            path: string.sub $path, 1, ((sizeof $path) - 1)
        end
    end

    @println terminal.text $terminal.YELLOW, "[" << $method << "] /" << $path

    set parts: string.split $path, "/"
    set action: ""
    if (sizeof $parts) > 0:
        action: $parts{0}
    end

    set response_body: ""
    set status: "200 OK"
    set content_type: "application/json"

    ; ROUTE: Dynamic HTML Dashboard
    if $action == "":
        set content_type: "text/html; charset=utf-8"
        set template: readfile "index.html"
        set rows: ""
        set k: 0
        while $k < (sizeof $db_keys):
            set db_key: $db_keys{$k}
            set db_val: $db{$db_key}
            set btn: "<a class='btn-del' href='/delete/" << $db_key << "'>Delete</a>"
            rows: $rows << "<tr><td>" << $db_key << "</td><td>" << $db_val << "</td><td>" << $btn << "</td></tr>"
            k: $k + 1
        end

        response_body: string.replace $template, "{{table_rows}}", $rows

    ; ROUTE: API Set
    elseif $action == "set":
        if (sizeof $parts) >= 3:
            set key: $parts{1}
            set val: $parts{2}
            set exists: 0
            set k: 0
            while $k < (sizeof $db_keys):
                if $db_keys{$k} == $key: exists: 1 break end
                k: $k + 1
            end
            if $exists == 0: set_index $db_keys, (sizeof $db_keys), $key end
            set_index $db, $key, $val
            save_db
            set status: "302 Found"
            set header: "HTTP/1.1 302 Found\r\nLocation: /\r\n\r\n"
            web.send $client, $header
            web.close $client
            return
        else:
            status: "400 Bad Request"
            response_body: "{ 'error': 'Usage: /set/key/value' }"
        end

    ; ROUTE: API Delete
    elseif $action == "delete":
        if (sizeof $parts) >= 2:
            set target_key: $parts{1}
            set_index $db, $target_key, 0
            set new_keys: []
            set k: 0

            while $k < (sizeof $db_keys):
                set current_key: $db_keys{$k}
                if $current_key != $target_key:
                    set_index $new_keys, (sizeof $new_keys), $current_key
                end
                k: $k + 1
            end

            set db_keys: $new_keys
            save_db

            set status: "302 Found"
            set header: "HTTP/1.1 302 Found\r\nLocation: /\r\n\r\n"
            web.send $client, $header
            web.close $client
            return
        else:
            status: "400 Bad Request"
            response_body: "{ 'error': 'Usage: /delete/key' }"
        end

    ; ROUTE: API Get
    elseif $action == "get":
        if (sizeof $parts) >= 2:
            set key: $parts{1}
            set val: $db{$key}
            if (typeof $val) == "int":
                status: "404 Not Found"
                response_body: "{ 'error': 'Key not found' }"
            else:
                response_body: "{ 'key': '" << $key << "', 'value': '" << $val << "' }"
            end
        else:
            status: "400 Bad Request"
            response_body: "{ 'error': 'Usage: /get/key' }"
        end
    else:
        status: "404 Not Found"
        response_body: "{ 'error': 'Unknown command.' }"
    end

    set header: "HTTP/1.1 " << $status << "\r\n"
    header: $header << "Server: NewtonWeb/2.0\r\n"
    header: $header << "Content-Type: " << $content_type << "\r\n"
    header: $header << "Content-Length: " << (sizeof $response_body) << "\r\n"
    header: $header << "Connection: close\r\n\r\n"

    web.send $client, $header << $response_body

    if $status == "200 OK": @println terminal.success "  -> " << $status
    else: @println terminal.error "  -> " << $status end

    process.sleep 1
    web.close $client
end

fun main:
    set port: 8080
    @println terminal.text $terminal.CYAN, "--- NEWTON WEB DASHBOARD v2.0 ---"

    load_db
    ensure_template_html

    @println terminal.text $terminal.BLUE, "[*] Running on http://localhost:" << $port

    set server: web.new 0
    web.bind $server, $port
    web.listen $server

    while 1 == 1:
        set client: web.accept $server
        handle_request $client
    end
end
