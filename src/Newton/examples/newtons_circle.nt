using std::math

fun main:
    @println "--- Newton's Circle (Calculated via Newton's Method) ---"
    set radius: 8.0
    set y: -10

    while $y <= 10:
        set row: ""
        set x: -16

        while $x <= 16:
            ; Convert coordinates to float for math
            set fx: float $x
            set fy: float $y

            ; Calculate Distance: d = sqrt(x^2 + y^2)
            set dist: math.sqrt (($fx * $fx) + ($fy * $fy))

            ; Calculate difference from radius
            set diff: $dist - $radius

            ; Absolute value
            if $diff < 0.0:
                diff: 0.0 - $diff
            end

            if $diff < 0.6:
                row: $row << "#"
            elseif $dist < $radius:
                row: $row << "."
            else:
                row: $row << " "
            end
            x: $x + 1
        end
        @println $row
        y: $y + 1
    end
end
