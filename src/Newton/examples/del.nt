; Language: Newton
; Lines of Code: 16
; Imports: 0

fun main:
  set colors_by_name: (Bob: "Blue", Gob: "Green", Pob: "Purple")

  @println "Length of colors_by_name: " << (string (sizeof $colors_by_name))
  @println "-------------------"
  @println "VALUES BEFORE DELETION"

  foreach &key, &value, $colors_by_name:
    ; String Interpolation
    @println "{}: {}", $key, $value
  end

  @println "-------------------"
  delete $colors_by_name, "Bob"
  @println "VALUES AFTER DELETION"

  foreach &key, &value, $colors_by_name:
    ; String Concatenation
    @println $key << ": " << $value
  end
  @println "-------------------"
end
