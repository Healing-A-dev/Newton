using std::web
using std::json
using std::terminal

fun send_request: @args path
    ; Connect to the local KV Server
    set client: net_create 0
    set status: web.connect $client, 8080, 16777343
    if $status < 0:
        @println terminal.error "[-] Cannot connect to KV Server on port 8080."
        return
    end

    set req: "GET " << $path << " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
    web.send $client, $req

    set res: web.recieve $client, 4096
    web.close $client

    ; Parse HTTP and Json
    set parts: string.split $res, "\r\n\r\n"
    if (sizeof $parts) > 1:
        set body: $parts{1}
        set data: json.parse $body
        if (typeof $data{"error"}) != "int":
            @println terminal.error "[-] Error: " << $data{"error"}
        else:
            if (typeof $data{"value"}) != "int":
                @println terminal.success "[+] " << $data{"key"} << " = " << $data{"value"}
            else:
                @println terminal.success "[+] Action completed successfully."
            end
        end
    else:
        @println terminal.error "[-] Invalid server response."
    end
end

fun main:
    @println terminal.text $terminal.CYAN, "--- Newton KV Database REPL ---"
    @println "Commands: GET <key>, SET <key> <value>, DEL <key>, EXIT"

    while 1 == 1:
        set _input: @prompt "newton-db> "

        if $_input == "EXIT":
            @println "Goodbye!"
            break
        end

        set args: string.split $_input, " "
        set cmd: $args{0}

        if $cmd == "GET":
            if (sizeof $args) >= 2:
                web.send ("/get/" << $args{1})
            else:
                @println "Usage: GET <key>"
            end

        elseif $cmd == "SET":
            if (sizeof $args) >= 3:
                web.send ("/set/" << $args{1} << "/" << $args{2})
            else:
                @println "Usage: SET <key> <value>"
            end

        elseif $cmd == "DEL":
            if (sizeof $args) >= 2:
                web.send ("/delete/" << $args{1})
            else:
                @println "Usage: DEL <key>"
            end

        else:
            if (sizeof $_input) > 0:
                @println "Unknown command. Try GET, SET, or DEL."
            end
        end
    end
end
