using std::io
using std::web
using std::process
using std::file
using std::system

fun parse_path:
    @args req
    set i: 0
    set length: sizeof $req
    set start: 0
    set _end: 0
    set spaces_found: 0

    while $i < $length:
        set char: $req{$i}
        if $char == 32:
            if $spaces_found == 0:
                start: $i + 1
                spaces_found: 1
            else:
                if $spaces_found == 1:
                    _end: $i
                    spaces_found: 2
                end
            end
        end
        i: $i + 1
    end

    if $spaces_found < 2:
        return "/"
    end
    set path_len: $_end - $start
    return substring($req, $start, $path_len)
end

fun handle_client:
    @args client

    set req: web.recieve $client, 4096
    if sizeof ($req) == 0:
        web.close $client
        return 0
    end

    set path: parse_path $req
    set pid: process.id(0)

    @println "[Child PID: " << (string $pid) << "] Request: " << $path

    set status: "404 Not Found"
    set body: "<h1>404 Not Found</h1>"
    set content_type: "text/html"

    if $path == "/":
        status: "200 OK"
        body: "<h1>Newton Fork Server</h1><p>Served by Process ID: " << (string $pid) << "</p>"
    end

    if $path == "/api/status":
        status: "200 OK"
        content_type: "application/json"
        body: "{ 'status': 'running', 'pid': " << (string $pid) << " }"
    end

    ; Try to read local file if path matches (e.g., /index.html)
    if $path == "/index.html":
        set file_data: file.readEntireFile "index.html"
        if sizeof($file_data) > 0:
            status: "200 OK"
            body: $file_data
        end
    end

    set content_len: sizeof ($body)
    set headers: "HTTP/1.1 " << $status << "\r\n"
    headers: $headers << "Content-Type: " << $content_type << "\r\n"
    headers: $headers << "Content-Length: " << string($content_len) << "\r\n"
    headers: $headers << "Connection: close\r\n\r\n"

    set full_response: $headers << $body
    web.send $client, $full_response
    web.close $client
end

fun main:
    @println "--- Newton Forking HTTPD ---"
    @println "Parent PID: " << string(process.id(0))

    set server: web.new $web.socket
    web.bind $server, 8080
    web.listen $server
    @println "Listening on 0.0.0.0:8080..."

    while 1 == 1:
        set client: web.accept $server
        set pid: process.fork()
        if $pid == 0:
            ; --- CHILD PROCESS ---
            web.close $server
            handle_client $client
            process.exit 0
        else:
            ; --- PARENT PROCESS ---
            web.close $client
        end
    end
end
