; Language: Newton
; Lines of Code: 13
; Imports: 1

using Std::Terminal

fun main:
  set filename: $argv{0}
  if $filename == 0:
    @println Terminal.Error "Filename not provided"
    exit 1
  end

  @println "Reading file: " << $filename
  set content: readfile $filename
  @println "--- Content ---"
  @print $content
  @println "\n-----------------"
end
