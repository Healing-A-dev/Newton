; Filname: Collection.nt
; Description: Collection module for Newton's standard library
; Date: April 30th, 2026 *


fun Std_Remove: @args map, key
    return ["ok", (__sys_collection_delete $map, $key)]
end

fun Invert: @args map_list
	set __temp_map__: ()
	foreach &key, &value, $map_list:
		__temp_map__{$value}: $key
	end
	return $__temp_map__
end

fun HasKey: @args map_list, key
    set type_val: typeof $map_list
    if $type_val == "map":
        set val: $map_list{$key}
        if $val == 0:
            return ["ok", 0]
        else:
            return ["ok", 1]
        end
    else:
        IO.Std_Println "VALUE IS NOT A MAP"
        return ["error", "Failed type check"]
    end
end


fun Std_Push: @args map_val, value
		set map_type: typeof $map_val
    if $map_type == "map":
    	set map_len: sizeof $map_val
    	map_val{$map_len}: $value
    	return ["ok", $map_val]

    elseif $map_type == "list":
    	set map_len: sizeof $map_val
    	map_val{$map_len}: $value
    	return ["ok", $map_val]

    else:
    	return ["error", "Collection.push ; Expected type `map;list` got `" << $map_type << "`"]
    end
end


fun Std_Pop: @args map_list
	; --- MAPS ---
	if (typeof $map_list) == "map":

		; Since maps are iterated backwords (when using foreach)
		; Just loop once and pop whatever the first value is
		foreach &_null, &item, $map_list:
			__sys_collection_delete $map_list, $_null
			return ["ok", $item]
		end

	; --- LISTS ---
	elseif (typeof $map_list) == "list":
		set last_item: $map_list{(sizeof $map_list) - 1}
		__sys_collection_delete $map_list, ((sizeof $map_list) - 1)
		return ["ok", $last_item]

	else:
		return ["error", "Collection.pop ; Expected type `map;list` got `" << (typeof $map_list) << "`"]
	end

	return ["ok", 0]
end


fun Join: @args map_list, sep
	set out_string: ""
	set length: sizeof $map_list

	; MAPS
	if (typeof $map_list) == "map":
		set counter: 0
		foreach &_null, &item, $map_list:
			out_string: $out_string << $item
			if $counter < $length:
				out_string: $out_string << $sep
			end
			counter: $counter + 1
		end
		return ["ok", $out_string]

	; LISTS
	elseif (typeof $map_list) == "list":
		set counter: 0
		while $counter < $length:
			out_string: $out_string << $map_list{$counter}
			if $counter < ($length - 1):
				out_string: $out_string << $sep
			end
			counter: $counter + 1
		end
		return ["ok", $out_string]
	else:
		return ["error", "Collection.join ; Expected type `map;list` got `" << (typeof $map_list) << "`"]
	end

	return ["ok", 0]
end


fun Std_ToMap: @args val
	set val_type: typeof $val
	set result: ()

	if $val_type == "string":
		set count: 0
		while $count < (sizeof $val):
			Collection.Std_Push $result, (substring $val, $count, 1)
			count: $count + 1
		end
	elseif $val_type == "list":
		for &loc, 0, (sizeof $val), 1:
			result{$loc}: $val{$loc}
		end
	elseif $val_type == "map":
		result: $val
	else:
		return ["error", "Collection.toMap ; Expected type `map;list;string` got `" << $val_type << "`"]
	end
	return $result
end

fun Std_MallocArray: @args size
	set arr: __alloc_array $size
	return [@ok, $arr]
end

fun Std_ToList: @args val
	set val_type: typeof $val
	set result: []

	if $val_type == "string":
		while (sizeof $result) < (sizeof $val):
			result{(sizeof $result)}: substring $val, (sizeof $result), 1
		end
	elseif $val_type == "map":
		; Initial Conversion Loop
		set __temp__: []
		foreach &_null, &value, $val:
			__temp__{(sizeof $__temp__)}: $value
		end

		; Reversal Loop
		; [Since maps are iterated backwards, that order of values must be reversed to be equal once in a list]
		set idx: (sizeof $__temp__) - 1
		while $idx >= 0:
			result{(sizeof $result)}: $__temp__{$idx}
			idx: $idx - 1
		end
	elseif $val_type == "list":
		result: $val
	else:
		return ["error", "Collection.toList ; Expected type `map;list;string` got `" << $val_type << "`"]
	end
	return ["ok", $result]
end
