; Filename: os.nt
; Desctipion: OS module for Newton's standard library
; Date: April 13th, 2026

fun getenv: @args variable
	return __sys_getenv $variable
end

fun time:
	return __sys_time_now
end

fun timeSince: @args start
	set current: __sys_time_now
	return $current - $start
end

; For now return linux (until other platforms are fully implemented)
fun host:
	return "linux"
end

; Polymorphic execute function
; Accepts list, maps, and or strings as arguemnts
; List/Maps are automatically processed and joined together to create the final command
fun execute: @args cmd
	set commands: ""
	set cmd_type: typeof $cmd

	if $cmd_type == "map":

		; Reversing map order
		set sub_commands: ()
		foreach &_null, &command, $cmd:
			sub_commands{(sizeof $sub_commands)}: $command
		end

		foreach &_null, &command, $sub_commands:
			commands: $commands << (string $command) << " "
		end
	elseif $cmd_type == "list":
		set cmd_len: sizeof $cmd
		set s: 0
		while $s < $cmd_len:
			commands: $commands << (string $cmd{$s}) << " "
			s: $s + 1
		end
	else:
		commands: $commands << (string $cmd)
	end

  ; prints "ADD WINDOWS ACCESS!!!\n"

  set pid: proc_fork 0
  if $pid == 0:
      sys_exec $commands
      proc_exit 1
  else:
      proc_wait 0
  end
  return ["ok", 1]
end
