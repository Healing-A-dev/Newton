; ------------------------------------------
; Global Booleans (Functions to avoid having to use '$true', '$false') [OPTIONAL]
; ------------------------------------------
fun true: return 1 end
fun false: return 0 end

; ------------------------------------------
; Utility Functions
; ------------------------------------------
fun pass: end

fun iota:
	__iota__: $__iota__ + 1
	return ["ok", $__iota__]
end

fun iota_reset:
	__iota__: -1
	return ["ok", 1]
end
