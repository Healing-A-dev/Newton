; Filename: Base.nt
; Description: Base module for the newton standard library (automatically included)
; Date: April 30th, 2026 *

using std::io
using std::file
using std::string
using std::collection
using std::system

; ------------------------------------------
; Global Variables
; ------------------------------------------
set fmRead*: 0
set fmWrite*: 577
set fmAppend*: 1089
set __iota__*: -1
set argc*: Std_Base_newton_get_argc
set argv*: Std_Base_newton_get_argv

; ------------------------------------------
; Global Error Handling Macros
; ------------------------------------------
defmacro ok: return "ok" end
defmacro err: return "error" end

defmacro capture:
	return $M_ARGV{0}
end

defmacro isError:
	set res: $M_ARGV{0}
	return ($res{0} == "error")
end

defmacro getError:
	set msg: $M_ARGV{0}
	return $msg{1}
end

defmacro assert:
	set [stmt,  on_err]: [$M_ARGV{0}, $M_ARGV{1}]
	set args: []
	if (sizeof $M_ARGV) > 2: args: $M_ARGV{2} end
	if $stmt == 0:
		if (typeof $on_err) == "unknown":
			return ["ok", call $on_err($args{0}, $args{1}, $args{2}, $args{3}, $args{4}, $args{5}, $args{6}, $args{7}, $args{8}, $args{9})]
		else:
			return ["error", "Failed assertion: " << $on_err]
		end
	end
	return ["ok", 1]
end

; ----------------------------------------------------------------
; Print/Println Macros (Variadic Print/Println with interpolation)
; ----------------------------------------------------------------
defmacro println:
	set str_val: ""
	if (sizeof $M_ARGV) > 0:
		str_val: $M_ARGV{0}
	end
    if (string.has (string $str_val), "{}"):
		set [start, rep_counter]: [0, 0]
        set search: substring $str_val, $start, 2
        set arg_length: sizeof $M_ARGV
        while $start != (sizeof $str_val):
        	if (substring $search, 0, 1) == "{" and (substring $search, 1, 1) == "}" :
				if $arg_length - 1 != $rep_counter:
					rep_counter: $rep_counter + 1
					if (typeof $M_ARGV{$rep_counter}) == "map" or (typeof $M_ARGV{$rep_counter}) == "list":
						return ["error", "Cannot interpolate type '" << (typeof $M_ARGV{$rep_counter}) << "'"]
					end
					set chars: string.split $str_val, ""
					chars{$start}: string $M_ARGV{$rep_counter}
					chars{$start + 1}: ""
					str_val: collection.join $chars, ""
				end
        	end
        	start: $start + 1
        	search: substring $str_val, $start, 2
        end

		if $arg_length - 1 > $rep_counter:
			io.print $str_val
			for &s, $rep_counter + 1, $arg_length, 1:
				io.print " " << $M_ARGV{$s}
			end
			io.print "\n"
		else:
			io.println $str_val
		end
		return ["ok", 1]
    end

    ; No Interpolation (Regular Print) [Base]
	set arg_length: sizeof $M_ARGV
	if $arg_length < 2:
		io.println $str_val
	else:
	;	[Variadic]
		io.print "" << (string $str_val) << " "
		for &s, 1, $arg_length, 1:
			if $s != $arg_length - 1:
				match (typeof $M_ARGV{$s}):
					"string" -> prints $M_ARGV{$s}
					"number" -> prints $M_ARGV{$s}
					"float"  -> prints $M_ARGV{$s}
					"list"   -> io.print $M_ARGV{$s}
					"map"    -> io.print $M_ARGV{$s}
				end
				prints " "
			else:
				match (typeof $M_ARGV{$s}):
					"string" -> prints $M_ARGV{$s}, "\n"
					"number" -> prints $M_ARGV{$s}, "\n"
					"float"  -> prints $M_ARGV{$s}, "\n"
					"list"   -> io.println $M_ARGV{$s}
					"map"    -> io.println $M_ARGV{$s}
				end
			end
		end
	end
	return ["ok", 1]
end

defmacro print:
	set str_val: ""
	if (sizeof $M_ARGV) > 0:
		str_val: $M_ARGV{0}
	end
    if (string.has (string $str_val), "{}"):
		set [start, rep_counter]: [0, 0]
        set search: substring $str_val, $start, 2
        set arg_length: sizeof $M_ARGV
        while $start != (sizeof $str_val):
        	if (substring $search, 0, 1) == "{" and (substring $search, 1, 1) == "}" :
				if $arg_length - 1 != $rep_counter:
					rep_counter: $rep_counter + 1
					if (typeof $M_ARGV{$rep_counter}) == "map" or (typeof $M_ARGV{$rep_counter}) == "list":
						return ["error", "Cannot interpolate type '" << (typeof $M_ARGV{$rep_counter}) << "'"]
					end
					set chars: string.split $str_val, ""
					chars{$start}: string $M_ARGV{$rep_counter}
					chars{$start + 1}: ""
					str_val: collection.join $chars, ""
				end
        	end
        	start: $start + 1
        	search: substring $str_val, $start, 2
        end

		if $arg_length - 1 > $rep_counter:
			io.print $str_val
			for &s, $rep_counter + 1, $arg_length, 1:
				io.print " " << $M_ARGV{$s}
			end
		else:
			io.print $str_val
		end
		return ["ok", 1]
    end

    ; No Interpolation (Regular Print) [Base]
	set arg_length: sizeof $M_ARGV
	if $arg_length < 2:
		io.print $str_val
	else:
	;	[Variadic]
		io.print "" << (string $str_val) << " "
		for &s, 1, $arg_length, 1:
			if $s != $arg_length - 1:
				match (typeof $M_ARGV{$s}):
					"string" -> prints $M_ARGV{$s}
					"number" -> prints $M_ARGV{$s}
					"float"  -> prints $M_ARGV{$s}
					"list"   -> io.print $M_ARGV{$s}
					"map"    -> io.print $M_ARGV{$s}
				end
				prints " "
			else:
				match (typeof $M_ARGV{$s}):
					"string" -> prints $M_ARGV{$s}
					"number" -> prints $M_ARGV{$s}
					"float"  -> prints $M_ARGV{$s}
					"list"   -> io.print $M_ARGV{$s}
					"map"    -> io.print $M_ARGV{$s}
				end
			end
		end
	end
	return ["ok", 1]
end

; ------------------------------------------
; Global IO Function Wrappers
; ------------------------------------------
defmacro readln:
	if (sizeof $M_ARGV) < 1:
		return @capture io.readln
	else:
		return @capture io.prompt $M_ARGV{0}
	end
end

fun die: @args msg, errno
	if $errno == 0:
		errno: 1
	end
	sys_err $msg
	proc_exit $errno
end


; ------------------------------------------
; Global File Function Wrappers
; ------------------------------------------
fun fopen: @args file, flags
	set flag: $flags
	match $flag:
		"r" -> flag: $fmRead
		"w" -> flag: $fmWrite
		"a" -> flag: $fmAppend
	end
	return @capture file.open $file, $flag
end

fun fwrite: @args fd, data
	return @capture file.write $fd, $data
end

fun fwriteBytes: @args fd, data
	return @capture file.writeBytes $fd, $data
end

fun fclose: @args fd
	return @capture file.close $fd
end

fun fsizeof: @args file
	return @capture file.sizeof $file
end

fun readfile: @args file
	return @capture file.readEntireFile $file
end

fun fgets: @args fd, len
	return @capture file.read $fd, $len
end

fun fileExists: @args file
	return @capture file.exists $file
end

fun deleteFile: @args file
	return @capture file.delete $file
end

fun newDirectory: @args path
	return @capture file.newDirectory $path
end

; ------------------------------------------
; Global Collection Functions/Macros
; ------------------------------------------
fun list: @args val
	return @capture collection.toList $val
end

fun map: @args val
	return @capture collection.toMap $val
end

fun push: @args map_list, val
	return @capture collection.push $map_list, $val
end

fun pop: @args map_list
	return @capture collection.pop $map_list
end

fun delete: @args map_list, key
	return @capture collection.remove $map_list, $key
end

defmacro List:
	io.println "Broken currently [WIP]"
	;return collection.mallocArray $M_ARGV{0}
	return ["ok", []]
end

; ------------------------------------------
; Global System Functions (Usable but not practical)
; ------------------------------------------
fun Std_Base_newton_get_argc:
	return ["ok", (system.argc 0)]
end

fun Std_Base_newton_get_argv:
	set system_args: []
	for &arg, 0, ($argc - 1), 1:
	  system_args{$arg}: system.argv $arg
	end
	return ["ok", $system_args]
end

fun Std_Base_newton_update_argv: @args base_name
	set args: [$base_name]
	for &idx, 0, ($argc - 1), 1:
		args{$idx + 1}: $argv{$idx}
	end
	argv: $args
	argc: (sizeof $args)
	return ["ok", 1]
end

defmacro quit:
	system.exit $M_ARGV{0}
end
; ------------------------------------------
; Global String Functions/Macros
; ------------------------------------------
defmacro split:
	set delim: ""
	@assert (((sizeof $M_ARGV) > 0), "Invalid number of arguments for macro 'split'; Expected 1, got 0")
	@assert (((typeof $M_ARGV{0}) == "string"), "Invalid argument #1 for macro 'split'; Expected string, got " << (typeof $M_ARGV{0}))
	if (sizeof $M_ARGV) == 2:
		@assert (((typeof $M_ARGV{1}) == "string"), "Invalid argument #2 for macro 'split'; Expected string, got " << (typeof $M_ARGV{0}))
		delim: $M_ARGV{1}
	elseif (sizeof $M_ARGV) > 2:
		die "Invalid number of argmuents for macro 'split'; Max 2, got " << (string (sizeof $M_ARGV)), 1
	end
	set capture: @capture string.split $M_ARGV{0}, $delim
	if @isError $capture:
		(die (@getError $capture), 1)
	end
	return $capture{1}
end

defmacro splitToMap:
	set delim: ""
	@assert (((sizeof $M_ARGV) > 0), "Invalid number of arguments for macro 'splitToMap'; Expected 1, got 0")
	@assert (((typeof $M_ARGV{0}) == "string"), "Invalid argument #1 for macro 'splitToMap'; Expected string, got " << (typeof $M_ARGV{0}))
	if (sizeof $M_ARGV) == 2:
		@assert (((typeof $M_ARGV{1}) == "string"), "Invalid argument #2 for macro 'splitToMap'; Expected string, got " << (typeof $M_ARGV{0}))
		delim: $M_ARGV{1}
	elseif (sizeof $M_ARGV) > 2:
		die "Invalid number of argmuents for macro 'splitToMap'; Max 2, got " << (string (sizeof $M_ARGV)), 1
	end
	set capture: @capture string.splitToMap $M_ARGV{0}, $delim
	if @isError $capture:
		(die (@getError $capture), 1)
	end
	return $capture{1}
end

