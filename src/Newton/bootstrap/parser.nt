using std::os
using lexer
using ast
using errors
using enum

set globalImportedModules*: ()

; Helper Functions
fun newParser: @args tokens
  set result: ("tokens": $tokens, "pos": 0)
  return [@ok, $result]
end

fun peek: @args p, offset
  if $p{"pos"} + $offset >= (sizeof $p{"tokens"}):
    return lexer.newToken $enum.tokEof "", ""
  end
  return [@ok, ($p{"tokens"}{$p{"pos"} + $offset})]
end

fun advance: @args p
  set result: ""
  if $p{"pos"} < (sizeof $p{"tokens"}):
    result: $p{"tokens"}{$p{"pos"}}
    p{"pos"}: $p{"pos"} + 1
  else:
    result: lexer.newToken $enum.tokEof "", ""
  end
  return [@ok, $result]
end

fun pmatch: @args p, k
  set tok: parser.peek $p, 0
  if $tok{"kind"} == $k:
    parser.advance $p
    return [@ok, 1]
  end
  return [@ok, 0]
end

fun consume: @args p, k, err
  set tok: parser.peek $p, 0
  if $tok{"kind"} == $k:
    return [@ok, (parser.advance $p)]
  end
  errors.err $err, $tok{"line"}, "", ""
end

fun resolveModulePath: @args pathParts
  set relativePath: (Collection.join $pathParts, "/") << ".nt"
  set libPath: "lib" << "/" << $relativePath

  if fileExists $relativePath: return [@ok, $relativePath] end
  if fileExists $libPath: return [@ok, $libPath] end

  set envPath: os.getenv "NEWTON_PATH"
  if ($envPath != "") and (fileExists $envPath << "/" << $relativePath):
    return [@ok, $envPath << "/" << $relativePath]
  end

  ; ############################## ;
  ; # TODO: add AppDir() support # ;
  ; ############################## ;

  set globalPath: "/usr/local/lib/newton" << "/" << $relativePath
  if (fileExists $globalPath): return [@ok, $globalPath] end
  if (fileExists "/usr/local/lib/newton/lib" << "/" << $relativePath): return [@ok, "/usr/local/lib/newton/lib" << "/" << $relativePath] end
  return [@ok, ""]
end

fun parsePrimary: @args p
  set t: parser.peek $p, 0

  if $t{"kind"} == $enum.tokNumberLit:
    parser.advance $p
    set node: ast.astNode $enum.nkLiteral
    node{"strVal"}: $t{"lexeme"}
    node{"isString"}: 0
    return [@ok, $node]

  elseif $t{"kind"} == $enum.tokFloatLit:
    parser.advance $p
    set node: ast.astNode $enum.nkFloatLit
    node{"strVal"}: $t{"lexeme"}
    return [@ok, $node]

  elseif $t{"kind"} == $enum.tokStringLit:
    parser.advance $p
    set node: ast.astNode $enum.nkLiteral
    node{"strVal"}: $t{"lexeme"}
    node{"isString"}: 1
    return [@ok, $node]

  elseif $t{"kind"} == $enum.tokLBracket:
    parser.advance $p
    set elements: []
    set tok: parser.peek $p, 0

    while $tok{"kind"} == $enum.tokEol:
      parser.advance $p
      tok: parser.peek $p, 0
    end

    if $tok{"kind"} != $enum.tokRBracket:
      push $elements, (parser.parseExpression $p)
      while 1 == 1:
        tok: parser.peek $p, 0
        while $tok{"kind"} == $enum.tokEol:
          parser.advance $p
          tok: parser.peek $p, 0
        end
        if not (parser.pmatch $p, $enum.tokComma): break end
        while $tok{"kind"} == $enum.tokEol:
          parser.advance $p
          tok: parser.peek $p, 0
        end
        if $tok{"kind"} == $enum.tokRBracket: break end
        push $elements, (parser.parseExpression $p)
      end
    end

    while $tok{"kind"} == $enum.tokEol:
      parser.advance $p
    end
    parser.consume $p, $enum.tokRBracket, "Expected ']'"
    set node: ast.astNode $enum.nkBracket
    node{"children"}: $elements
    return [@ok, $node]

  elseif $t{"kind"} == $enum.tokMinus:
    parser.advance $p
    set val: parser.parsePrimary $p
    set node: ast.astNode $enum.nkBinaryOp
    set left: ast.astNode $enum.nkLiteral
    left{"strVal"}: "0"
    node{"op"}: "-"
    node{"left"}: $left
    node{"right"}: $val
    return [@ok, $node]

  elseif $t{"kind"} == $enum.tokNot:
    parser.advance $p
    set val: parser.parsePrimary $p
    set node: ast.astNode $enum.nkBinaryOp
    set left: ast.astNode $enum.nkLiteral
    left{"strVal"}: "0"
    node{"op"}: "not"
    node{"left"}: $left
    node{"right"}: $val
    return [@ok, $node]

  elseif $t{"kind"} == $enum.tokDollar:
    parser.advance $p
    set name: parser.consume $p, $enum.tokIdentifier, "Expected variable name after '$'"
    name: $name{"lexeme"}
    if parser.pmatch $p, $enum.tokDot:
      set prop: parser.consume $p, $enum.tokIdentifier, "Expected property"
      prop: $prop{"lexeme"}
      name: $name << "_" << $prop
    end
    set baseNode: ast.astNode $enum.nkVarRef
    set baseline: parser.peek $p, 0
    baseNode{"refName"}: $name
    baseNode{"line"}: $baseline{"line"}

    while parser.pmatch $p, $enum.tokLBrace:
      set keyNode: ""
      set tok: parser.peek $p, 0
      if $tok{"kind"} == $enum.tokIdentifier:
        set keyId: parser.advance $p
        keyId: $keyId{"lexeme"}
        keyNode: ast.astNode $enum.nkLiteral
        keyNode{"strVal"}: $keyId
        keyNode{"isString"}: 1
      else:
        keyNode: parser.parseExpression $p
      end
      parser.consume $p, $enum.tokRBrace, "Expected '}'"
      baseNode: ast.astNode $enum.nkMapGet
      baseNode{"targetMap"}: $baseNode
      baseNode{"targetKey"}: $keyNode
    end
    return [@ok, $baseNode]

  elseif $t{"kind"} == $enum.tokMacroRef:
    set lineNum: $t{"line"}
    set __temp__: parser.advance $p
    set name: "MACRO_" << $__temp__{"lexeme"}
    set args: []

    if parser.pmatch $p, $enum.tokLParen:
      set tok: parser.peek $p, 0
      if $tok{"kind"} != $enum.tokRParen:
        push $args, (parser.parseExpression $p)
        while (parser.pmatch $p, $enum.tokComma):
          push $args, (parser.parseExpression $p)
        end
      end
      parser.consume $p, $enum.tokRParen, "Expected ')'"
    else:
    end
  end
end


fun parseExpression: @args p
  return
end
