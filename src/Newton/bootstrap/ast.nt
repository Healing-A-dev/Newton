using enum

fun astNode: @args object
  set astNode: ("line": 0, "autoUnwrap": 0, "fromImport": 0)
  if $object == $enum.nkProgram:
    astNode{"stmts"}: []
  elseif $object == $enum.nkBlock:
    astNode{"blockStmts"}: []
  elseif ($object == $enum.nkVarDecl) or ($object == $enum.nkGlobalDecl) or ($object == $enum.nkAssignment):
    astNode{"varName"}: ""
    astNode{"varValue"}: $astNode
  elseif $object == $enum.nkVarRef:
    astNode{"refName"}: ""
  elseif ($object == $enum.nkLiteral) or ($object == $enum.nkFloatLit):
    astNode{"strVal"}: ""
    astNode{"isString"}: 0
  elseif ($object == $enum.nkBinaryOp) or ($object == $enum.nkInfix):
    astNode{"op"}: ""
    astNode{"left"}: $astNode
    astNode{"right"}: $astNode
  elseif ($object == $enum.nkCommand) or ($object == $enum.nkCall) or ($object == $enum.nkCallDynamic):
    astNode{"callName"}: ""
    astNode{"callTarget"}: $astNode
    astNode{"callArgs"}: []
  elseif $object == $enum.nkFunction:
    astNode{"fnName"}: ""
    astNode{"fnArgs"}: []
    astNode{"fnBody"}: $astNode
    astNode{"fnExpo"}: 0
  elseif $object == $enum.nkReturn:
    astNode{"returnVal"}: $astNode
  elseif $object == $enum.nkIf:
    astNode{"condition"}: $astNode
    astNode{"thenBranch"}: $astNode
    astNode{"elseBranch"}: $astNode
  elseif $object == $enum.nkLoop:
    astNode{"loopType"}: ""
    astNode{"loopArgs"}: []
    astNode{"loopBody"}: $astNode
  elseif $object == $enum.nkWhile:
    astNode{"whileCondition"}: $astNode
    astNode{"whileBody"}: $astNode
  elseif $object == $enum.nkInput:
    set __discard__: 1
  elseif $object == $enum.nkMapLit:
    astNode{"mapKeys"}: []
    astNode{"mapValues"}: []
    astNode{"isList"}: 0
  elseif $object == $enum.nkMapGet:
    astNode{"targetMap"}: $astNode
    astNode{"targetKey"}: $astNode
  elseif $object == $enum.nkDel:
    astNode{"delMap"}: $astNode
    astNode{"delKey"}: $astNode
  elseif $object == $enum.nkBracket:
    astNode{"children"}: []
  elseif $object == $enum.nkMatch:
    astNode{"matchTarget"}: $astNode
    astNode{"matchBranches"}: []
  elseif $object == $enum.nkMatchBranch:
    astNode{"branchCond"}: $astNode
    astNode{"branchBody"}: $astNode
  elseif $object == $enum.nkDestructionDecl:
    astNode{"destructNames"}: []
    astNode{"destructVal"}: $astNode
  elseif $object == $enum.nkForeachFile:
    astNode{"fileLoopVar"}: ""
    astNode{"fileLoopTarget"}: $astNode
    astNode{"fileLoopBody"}: $astNode
  elseif $object == $enum.nkForeachMap:
    astNode{"mapLoopKey"}: ""
    astNode{"mapLoopVal"}: ""
    astNode{"mapLoopTarget"}: $astNode
    astNode{"mapLoopBody"}: $astNode
  end
  return [@ok, $astNode]
end
