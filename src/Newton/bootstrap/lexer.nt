using enum
using errors

set keywords*: (
	"set":      $enum.tokSet,
	"if":       $enum.tokIf,
	"elseif":   $enum.tokElseIf,
	"else":     $enum.tokElse,
	"end":      $enum.tokEnd,
	"fun":      $enum.tokFun,
	"for":      $enum.tokFor,
	"foreach":  $enum.tokForeach,
	"while":    $enum.tokWhile,
	"return":   $enum.tokReturn,
	"using":    $enum.tokUsing,
	"input":    $enum.tokInput,
	"call":     $enum.tokCall,
	"and":      $enum.tokAnd,
	"or":       $enum.tokOr,
	"match":    $enum.tokMatch,
	"not":      $enum.tokNot,
	"shl":      $enum.tokShl,
	"in":       $enum.tokIn,
	"defmacro": $enum.tokDefmacro,
	"exposed":  $enum.tokExposed
)

; Token Creator
fun newToken: @args kind, lexeme, line
	set Token: ("kind": $kind, "lexeme": $lexeme, "line": $line)
	return [@ok, $Token]
end

; Digit Checker
fun isDigit: @args char
	if (typeof $char) != "string": return [@ok, 0] end
	if (sizeof $char) == 0: return [@ok, 0] end
	set ascii: string.ascii $char
	if ($ascii >= 48) and ($ascii <= 57):
		return [@ok, 1]
	end
	return [@ok, 0]
end

; Alpha Checkers
fun isAlphaAscii: @args char
	if (typeof $char) != "string": return [@ok, 0] end
	if (sizeof $char) == 0: return [@ok, 0] end
	set ascii: string.ascii $char
	if ($ascii >= 65) and ($ascii <= 90):
		return [@ok, 1]
	elseif ($ascii >= 97) and ($ascii <= 122):
		return [@ok, 1]
	end
	return [@ok, 0]
end

fun isAlphanumeric: @args char
	if (typeof $char) != "string": return [@ok, 0] end
	if (sizeof $char) == 0: return [@ok, 0] end
	set ascii: string.ascii $char
	if ($ascii >= 48) and ($ascii <= 57):
		return [@ok, 1]
	elseif ($ascii >= 65) and ($ascii <= 90):
		return [@ok, 1]
	elseif ($ascii >= 97) and ($ascii <= 122):
		return [@ok, 1]
	elseif $ascii == 95:
		return [@ok, 1]
	end
	return [@ok, 0]
end

; Lexer
fun lex: @args data
	set tokens: []
	set current: 0
	set line: 1
	set dataLen: sizeof $data

	while $current < $dataLen:
		set start: $current
		set c: substring $data, $current, 1
		current: $current + 1

		; Symbols
		if $c == "\n":
			push $tokens, (lexer.newToken $enum.tokEol, $c, $line)
			line: $line + 1
		elseif ($c == " ") or ($c == "\r") or ($c == "\t"):
			set __discard__: 0
		elseif $c == ";":
			while $current < $dataLen:
				set sc: substring $data, $current, 1
				if $sc == "\n": break end
				current: $current + 1
			end
		elseif $c == "(": push $tokens, (lexer.newToken $enum.tokLParen, $c, $line)
		elseif $c == ")": push $tokens, (lexer.newToken $enum.tokRParen, $c, $line)
		elseif $c == "{": push $tokens, (lexer.newToken $enum.tokLBrace, $c, $line)
		elseif $c == "}": push $tokens, (lexer.newToken $enum.tokRBrace, $c, $line)
		elseif $c == "[": push $tokens, (lexer.newToken $enum.tokLBracket, $c, $line)
		elseif $c == "]": push $tokens, (lexer.newToken $enum.tokRBracket, $c, $line)
		elseif $c == ":":
			if ($current < $dataLen) and ((substring $data, $current, 1) == ":"):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokDoubleColon, "::", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokColon, $c, $line)
			end
		elseif $c == ".": push $tokens, (lexer.newToken $enum.tokDot, $c, $line)
		elseif $c == ",": push $tokens, (lexer.newToken $enum.tokComma, $c, $line)
		elseif $c == "$": push $tokens, (lexer.newToken $enum.tokDollar, $c, $line)
		elseif $c == "&": push $tokens, (lexer.newToken $enum.tokAmpersand, $c, $line)
		elseif $c == "+": push $tokens, (lexer.newToken $enum.tokPlus, $c, $line)
		elseif $c == "*": push $tokens, (lexer.newToken $enum.tokStar, $c, $line)
		elseif $c == "/": push $tokens, (lexer.newToken $enum.tokSlash, $c, $line)
		elseif $c == "%": push $tokens, (lexer.newToken $enum.tokMod, $c, $line)
		elseif $c == "^": push $tokens, (lexer.newToken $enum.tokBitXor, $c, $line)

		; Comparisons
		; -, ->
		elseif $c == "-":
			if ($current < $dataLen) and ((substring $data, $current, 1) == ">"):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokArrow, "->", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokMinus, $c, $line)
			end

		; <, <=, <<
		elseif $c == "<":
			if ($current < $dataLen) and ((substring $data, $current, 1) == "="):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokLe, "<=", $line)
			elseif ($current < $dataLen) and ((substring $data, $current, 1) == "<"):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokConcat, "<<", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokLt, $c, $line)
			end

		; >, >=, >>
		elseif $c == ">":
			if ($current < $dataLen) and ((substring $data, $current, 1) == "="):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokGe, ">=", $line)
			elseif ($current < $dataLen) and ((substring $data, $current, 1) == ">"):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokShr, ">>", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokGt, $c, $line)
			end

		; ==, ERROR
		elseif $c == "=":
			if ($current < $dataLen) and ((substring $data, $current, 1) == "="):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokEqEq, "==", $line)
			else:
				errors.err "Unexpected symbol '='. Did you mean '=='?", $line, "", ""
			end

		; !=, ERROR
		elseif $c == "!":
			if ($current < $dataLen) and ((substring $data, $current, 1) == "="):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokNeq, "!=", $line)
			else:
				errors.err "Unexpected symbol '!'. Did you mean '!='?", $line, "", ""
			end

		; Macro Handling
		elseif $c == "@":
			set text: "@"
			while $current < $dataLen:
				set ch: substring $data, $current, 1
				if (lexer.isAlphanumeric $ch) == 0: break end
				text: $text << $ch
				current: $current + 1
			end

			if $text == "@args":
				push $tokens, (lexer.newToken $enum.tokAtArgs, $text, $line)
			elseif $text == "@namespace":
				push $tokens, (lexer.newToken $enum.tokNamespace, $text, $line)
			else:
				set macroName: substring $text, 1, ((sizeof $text) - 1)
				push $tokens, (lexer.newToken $enum.tokMacroRef, $macroName, $line)
			end

		; Strings
		elseif $c == "\"":
			set strVal: ""
			while $current < $dataLen:
				set ch: substring $data, $current, 1
				if $ch == "\"": break end
				if ($ch == "\\") and ($current + 1 < $dataLen):
					strVal: $strVal << "\\"
					current: $current + 1
					set esc: substring $data, $current, 1
					strVal: $strVal << $esc
				else:
					strVal: $strVal << $ch
				end
				current: $current + 1
			end
			if ($current < $dataLen) and ((substring $data, $current, 1) == "\""):
				current: $current + 1
			end
			push $tokens, (lexer.newToken $enum.tokStringLit, $strVal, $line)
		else:
			if (lexer.isDigit $c):
				while $current < $dataLen:
					set ch: substring $data, $current, 1
					if (lexer.isDigit $ch) == 0: break end
					current: $current + 1
				end
				if ($current < $dataLen) and ((substring $data, $current, 1) == "."):
					set isFloat: 0
					if ($current + 1 < $dataLen) and (lexer.isDigit (substring $data, $current + 1, 1)):
						isFloat: 1
					end
					if $isFloat:
						current: $current + 1
						while $current < $dataLen:
							set ch: substring $data, $current, 1
							if (lexer.isDigit $ch) == 0: break end
							current: $current + 1
						end
						set decimal: substring $data, $start, ($current - $start)
						push $tokens, (lexer.newToken $enum.tokFloatLit, $decimal, $line)
					else:
						set number: substring $data, $start, ($current - $start)
						push $tokens, (lexer.newToken $enum.tokNumberLit, $number, $line)
					end
				else:
					set number: substring $data, $start, ($current - $start)
					push $tokens, (lexer.newToken $enum.tokNumberLit, $number, $line)
				end
			elseif (lexer.isAlphaAscii $c) or ($c == "_") or ($c == "#"):
				while $current < $dataLen:
					set ch: substring $data, $current, 1
					if ((lexer.isAlphanumeric $ch) == 0) and ($ch != "_"): break end
					current: $current + 1
				end
				set text: substring $data, $start, ($current - $start)
				set kwVal: $lexer.keywords{$text}
				if $kwVal != 0:
					push $tokens, (lexer.newToken $kwVal, $text, $line)
				else:
					push $tokens, (lexer.newToken $enum.tokIdentifier, $text, $line)
				end
			else:
				errors.err "Unexpected character: '" << $c << "'", $line, "", ""
			end
		end
	end
	push $tokens, (lexer.newToken $enum.tokEof, "", $line)
	return [@ok, $tokens]
end
