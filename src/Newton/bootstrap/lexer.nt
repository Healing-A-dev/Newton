using enum
using errors

set keywords*: (
	"set":      $enum.tokSet,
	"if":       $enum.tokIf,
	"elseif":   $enum.tokElseIf,
	"else":     $enum.tokElse,
	"end":      $enum.tokEnd,
	"fun":      $enum.tokFun,
	"for":      $enum.tokFor,
	"foreach":  $enum.tokForeach,
	"while":    $enum.tokWhile,
	"return":   $enum.tokReturn,
	"using":    $enum.tokUsing,
	"input":    $enum.tokInput,
	"call":     $enum.tokCall,
	"and":      $enum.tokAnd,
	"or":       $enum.tokOr,
	"match":    $enum.tokMatch,
	"not":      $enum.tokNot,
	"shl":      $enum.tokShl,
	"in":       $enum.tokIn,
	"defmacro": $enum.tokDefmacro,
	"exposed":  $enum.tokExposed
)

; Token Creator
fun newToken: @args kind, lexeme, line
	return [@ok, [$kind, $lexeme, $line]]
end

; Digit Checker
fun isDigit: @args b
	if ($b >= 48) and ($b <= 57):
		return [@ok, 1]
	end
	return [@ok, 0]
end

; Alpha Checkers
fun isAlphaAscii: @args b
	if ($b >= 65) and ($b <= 90):
		return [@ok, 1]
	elseif ($b >= 97) and ($b <= 122):
		return [@ok, 1]
	end
	return [@ok, 0]
end

fun isAlphanumeric: @args b
	if ($b >= 48) and ($b <= 57):
		return [@ok, 1]
	elseif ($b >= 65) and ($b <= 90):
		return [@ok, 1]
	elseif ($b >= 97) and ($b <= 122):
		return [@ok, 1]
	elseif $b == 95:
		return [@ok, 1]
	end
	return [@ok, 0]
end

; Lexer
fun lex: @args data
	set tokens: []
	set current: 0
	set line: 1
	set dataLen: sizeof $data

	while $current < $dataLen:
		set start: $current
		set b: $data{$current}
		current: $current + 1

		; Whitespace
		if $b == 10:
			push $tokens, (lexer.newToken $enum.tokEol, "\n", $line)
			line: $line + 1
		elseif ($b == 32) or ($b == 13) or ($b == 9):
			set __discard__: 0
		; Comments
		elseif $b == 59:
			while $current < $dataLen:
				set sc: $data{$current}
				if $sc == 10: break end
				current: $current + 1
			end
		; Single-character delimiters
		elseif $b == 40: push $tokens, (lexer.newToken $enum.tokLParen, "(", $line)
		elseif $b == 41: push $tokens, (lexer.newToken $enum.tokRParen, ")", $line)
		elseif $b == 123: push $tokens, (lexer.newToken $enum.tokLBrace, "{", $line)
		elseif $b == 125: push $tokens, (lexer.newToken $enum.tokRBrace, "}", $line)
		elseif $b == 91: push $tokens, (lexer.newToken $enum.tokLBracket, "[", $line)
		elseif $b == 93: push $tokens, (lexer.newToken $enum.tokRBracket, "]", $line)
		elseif $b == 58:
			if ($current < $dataLen) and ($data{$current} == 58):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokDoubleColon, "::", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokColon, ":", $line)
			end
		elseif $b == 46: push $tokens, (lexer.newToken $enum.tokDot, ".", $line)
		elseif $b == 44: push $tokens, (lexer.newToken $enum.tokComma, ",", $line)
		elseif $b == 36: push $tokens, (lexer.newToken $enum.tokDollar, "$", $line)
		elseif $b == 38: push $tokens, (lexer.newToken $enum.tokAmpersand, "&", $line)
		elseif $b == 43: push $tokens, (lexer.newToken $enum.tokPlus, "+", $line)
		elseif $b == 42: push $tokens, (lexer.newToken $enum.tokStar, "*", $line)
		elseif $b == 47: push $tokens, (lexer.newToken $enum.tokSlash, "/", $line)
		elseif $b == 37: push $tokens, (lexer.newToken $enum.tokMod, "%", $line)
		elseif $b == 94: push $tokens, (lexer.newToken $enum.tokBitXor, "^", $line)

		; Comparisons
		; -, ->
		elseif $b == 45:
			if ($current < $dataLen) and ($data{$current} == 62):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokArrow, "->", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokMinus, "-", $line)
			end

		; <, <=, <<
		elseif $b == 60:
			if ($current < $dataLen) and ($data{$current} == 61):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokLe, "<=", $line)
			elseif ($current < $dataLen) and ($data{$current} == 60):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokConcat, "<<", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokLt, "<", $line)
			end

		; >, >=, >>
		elseif $b == 62:
			if ($current < $dataLen) and ($data{$current} == 61):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokGe, ">=", $line)
			elseif ($current < $dataLen) and ($data{$current} == 62):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokShr, ">>", $line)
			else:
				push $tokens, (lexer.newToken $enum.tokGt, ">", $line)
			end

		; ==, ERROR
		elseif $b == 61:
			if ($current < $dataLen) and ($data{$current} == 61):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokEqEq, "==", $line)
			else:
				errors.err "Unexpected symbol '='. Did you mean '=='?", $line, "", ""
			end

		; !=, ERROR
		elseif $b == 33:
			if ($current < $dataLen) and ($data{$current} == 61):
				current: $current + 1
				push $tokens, (lexer.newToken $enum.tokNeq, "!=", $line)
			else:
				errors.err "Unexpected symbol '!'. Did you mean '!='?", $line, "", ""
			end

		; Macro Handling
		elseif $b == 64:
			while $current < $dataLen:
				set mb: $data{$current}
				if (lexer.isAlphanumeric $mb) == 0: break end
				current: $current + 1
			end
			set text: substring $data, $start, ($current - $start)

			if $text == "@args":
				push $tokens, (lexer.newToken $enum.tokAtArgs, $text, $line)
			elseif $text == "@namespace":
				push $tokens, (lexer.newToken $enum.tokNamespace, $text, $line)
			else:
				set macroName: substring $text, 1, ((sizeof $text) - 1)
				push $tokens, (lexer.newToken $enum.tokMacroRef, $macroName, $line)
			end

		; Strings
		elseif $b == 34:
			set strStart: $current
			while $current < $dataLen:
				set sb: $data{$current}
				if $sb == 34:
					break
				elseif ($sb == 92) and ($current + 1 < $dataLen):
					current: $current + 2
				else:
					current: $current + 1
				end
			end
			set strVal: substring $data, $strStart, ($current - $strStart)
			if ($current < $dataLen) and ($data{$current} == 34):
				current: $current + 1
			end
			push $tokens, (lexer.newToken $enum.tokStringLit, $strVal, $line)

		; Numbers and Identifiers
		else:
			if (lexer.isDigit $b):
				while $current < $dataLen:
					set db: $data{$current}
					if (lexer.isDigit $db) == 0: break end
					current: $current + 1
				end
				if ($current < $dataLen) and ($data{$current} == 46):
					set isFloat: 0
					if ($current + 1 < $dataLen) and (lexer.isDigit ($data{$current + 1})):
						isFloat: 1
					end
					if $isFloat:
						current: $current + 1
						while $current < $dataLen:
							set fdb: $data{$current}
							if (lexer.isDigit $fdb) == 0: break end
							current: $current + 1
						end
						set decimal: substring $data, $start, ($current - $start)
						push $tokens, (lexer.newToken $enum.tokFloatLit, $decimal, $line)
					else:
						set number: substring $data, $start, ($current - $start)
						push $tokens, (lexer.newToken $enum.tokNumberLit, $number, $line)
					end
				else:
					set number: substring $data, $start, ($current - $start)
					push $tokens, (lexer.newToken $enum.tokNumberLit, $number, $line)
				end
			elseif (lexer.isAlphaAscii $b) or ($b == 95) or ($b == 35):
				while $current < $dataLen:
					set ab: $data{$current}
					if ((lexer.isAlphanumeric $ab) == 0) and ($ab != 95): break end
					current: $current + 1
				end
				set text: substring $data, $start, ($current - $start)
				set kwVal: $lexer.keywords{$text}
				if $kwVal != 0:
					push $tokens, (lexer.newToken $kwVal, $text, $line)
				else:
					push $tokens, (lexer.newToken $enum.tokIdentifier, $text, $line)
				end
			else:
				errors.err "Unexpected character code: " << (string $b), $line, "", ""
			end
		end
	end
	push $tokens, (lexer.newToken $enum.tokEof, "", $line)
	return [@ok, $tokens]
end
