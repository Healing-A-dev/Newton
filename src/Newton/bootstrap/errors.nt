using std::Math

set newtonDiagnostic*: (
	line: 0,
	code: "",
	hint: "",
)

set isLspMode*: false
set currentCompilingFile*: ""
set errCount*: 0

fun repeat: @args v, count
	set __out__: ""
	for &s, 0, $count, 1:
		__out__: $__out__ << $v
	end
	return $__out__
end

fun stripLeadingWhitespace: @args str
	set start: 0
	set count: 0
	for &s, 0, (sizeof $str), 1:
		if $str{$s} != 32 and $str{$s} != 9:
			start: $s
			break
		else:
			match $str{$s}:
				32 -> count: $count + 1
				9  -> count: $count + 2
			end
		end
	end
	return (String: (string.sub $str, $start, (sizeof $str) - $start), Spaces: $count)
end

fun err: @args msg, line, code, hint
 	if $errors.errCount >= 10:
 		@println "Compilation failed with <\x1b[1;31m{}\x1b[0m> errors", $errors.errCount
 		@quit 1
 	end

 	set final_code: $code
 	set final_hint: $hint

 	if $final_code == "":
 		if (string.has $msg, "Unexpected character"):
 			final_code: "E001"
 			if $final_hint == "": final_hint: "The lexer encountered an invalid character. Did you make a typo?" end
 		elseif (string.has $msg, "Expected") or (string.has $msg, "Unknown statement"):
 			final_code: "E002"
 			if $final_hint == "": final_hint: "The parser encountred an unexpected token. Check for missing commas, colons, or mismatched/missing " << "brackets, parenthesis, and/or braces." end
 		elseif (string.has $msg, "Could not find module"):
 			final_code: "E003"
 			if $final_hint == "": final_hint: "Module resolution failed. Check if the file exists in the correct directory, or verify your import ('using') path." end
 		else:
 			final_code: "E099"
 			if $final_hint == "": final_hint: "An internal compilation constraint was violated." end
 		end
 	end

 	; TODO: Implement LSP errors
 	if $errors.isLspMode:
 		set e: $errors.newtonDiagnostic
 		die $e{hint}, 10
 	end

 	if $errors.errCount == 0:
 		@println "\x1b[1;31m--- [ COMPILER FAULT ] ---\x1b[0m"
 		@println "\x1b[1mCode   :\x1b[0m", $final_code
 		@println "\x1b[1mFile   :\x1b[0m {} (Line {})", $errors.currentCompilingFile, $line
 		@println "\x1b[1mReason :\x1b[0m {}\n", $msg

 		set line_content: ""
 		if (fileExists $errors.currentCompilingFile):
 			set lines: string.split (readfile $errors.currentCompilingFile), "\n"
 			if $line > 0 and $line <= (sizeof $lines):
 				line_content: $lines{$line - 1}
 			end
 		end

 		if $line_content != 0:
 			set pad: errors.repeat " ", (sizeof (string $line))
 			@println "  {} | {}", $line, $line_content

 			set trimmed: errors.stripLeadingWhitespace $line_content
 			set space_count: $trimmed{"Spaces"}
 			set squiggly: (errors.repeat " ", $space_count) << "\x1b[1;31m" << (errors.repeat "^", (math.max 1, (sizeof $trimmed{"String"}))) << "\x1b[0m"

 			@println "  {} | {}", $pad, $squiggly
 		else:
 			@println "  <source code unavailable>"
 		end

 		@println ""
 		if $final_hint != "": @println "\x1b[1;30mHint  :\x1b[0m " << $final_hint end
 	end
 	errors.errCount: $errors.errCount + 1
end
